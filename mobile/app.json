{
  "expo": {
    "name": "SabiPesin",
    "slug": "sabipesin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "sabipesin",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.sabipesin.app"
    },
    "android": {
      "package": "ng.sabipesin.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
