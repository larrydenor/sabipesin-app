# Copy this file to .env and fill in real values. Never commit .env.
# Provision a fresh MongoDB Atlas cluster under SabiPesin Ltd — do NOT reuse
# the old shared bootcamp credentials that were previously hardcoded here.
MONGODB_URI=
PORT=3333

# JWT auth — use long, random, distinct values for each secret.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional overrides (defaults: 15m access, 30d refresh).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS OTP (phone verification) — Termii (switched from Africa's Talking).
# We generate/verify the OTP ourselves and use Termii only to deliver the SMS
# (its managed Token API is not activated for our account's country).
OTP_PROVIDER=termii
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
# 'generic' works for non-DND numbers; use 'dnd' (with an approved Sender ID) to
# reach DND-registered numbers in production.
TERMII_CHANNEL=generic
# TODO(sabipesin-credentials): must be an APPROVED Termii Sender ID. Currently
# borrowing CraftRanked's ("Craftranked") while SabiPesin's own account clears
# CAC — swap to SabiPesin's own approved Sender ID before launch.
TERMII_SENDER_ID=SabiPesin

# Photo storage — Cloudinary. Copy the full "API environment variable" string
# from the SabiPesin Cloudinary dashboard. Contains the API secret, so the real
# value belongs only in .env (gitignored), never in this committed template.
CLOUDINARY_URL=
