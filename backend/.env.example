# Copy this file to .env and fill in real values. Never commit .env.
# Provision a fresh MongoDB Atlas cluster under SabiPesin Ltd — do NOT reuse
# the old shared bootcamp credentials that were previously hardcoded here.
MONGODB_URI=
PORT=3333

# JWT auth — use long, random, distinct values for each secret.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional overrides (defaults: 15m access, 30d refresh).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS OTP (phone verification) — Termii (switched from Africa's Talking).
# We generate/verify the OTP ourselves and use Termii only to deliver the SMS
# (its managed Token API is not activated for our account's country).
OTP_PROVIDER=termii
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
# 'generic' works for non-DND numbers; use 'dnd' (with an approved Sender ID) to
# reach DND-registered numbers in production.
TERMII_CHANNEL=generic
# TODO(sabipesin-credentials): must be an APPROVED Termii Sender ID. Currently
# borrowing CraftRanked's ("Craftranked") while SabiPesin's own account clears
# CAC — swap to SabiPesin's own approved Sender ID before launch.
TERMII_SENDER_ID=SabiPesin

# NIN + selfie (KYC) verification — QoreID.
# QOREID_ENABLED gates the real vendor call. Leave 'false' for local dev/tests:
# POST /verification/nin/start then returns a mocked-but-well-formed session and
# never hits (or bills) QoreID. Set to 'true' with real credentials to run the
# live integration. Sandbox uses the same base URL with sandbox credentials.
# TODO(sabipesin-credentials): production QoreID account is blocked pending CAC
# docs — swap CLIENT_ID/SECRET to production and set QOREID_ENABLED=true before launch.
KYC_PROVIDER=qoreid
QOREID_ENABLED=false
QOREID_CLIENT_ID=
QOREID_SECRET=
QOREID_WEBHOOK_SECRET=
QOREID_BASE_URL=https://api.qoreid.com
# A QoreID /v1/sessions call runs EITHER a dashboard workflow (set QOREID_WORKFLOW_ID,
# a number) OR a single product ("collection" session, set QOREID_NIN_PRODUCT_CODE).
# They are mutually exclusive; workflow takes precedence when both are set.
QOREID_WORKFLOW_ID=
# Product codes are short slugs (e.g. 'nin', 'liveness'). The exact code for the
# combined NIN + selfie face-match flow is TBD pending account subscription.
QOREID_NIN_PRODUCT_CODE=nin
QOREID_SESSION_TTL_SECONDS=900
QOREID_SESSION_MAX_ATTEMPTS=3

# Photo storage — Cloudinary. Copy the full "API environment variable" string
# from the SabiPesin Cloudinary dashboard. Contains the API secret, so the real
# value belongs only in .env (gitignored), never in this committed template.
CLOUDINARY_URL=

